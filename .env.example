# Copy this file to .env.local and fill in your key.
# Get a key at https://console.anthropic.com/settings/keys
#
# IMPORTANT: Use a WORKSPACE-scoped key (created inside a Workspace), not an
# organization/admin key. Admin keys cannot call the Messages API directly.
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MAX_TOKENS=max-tokens

# Optional: override the Claude model (defaults to claude-sonnet-5)
# ANTHROPIC_MODEL=claude-sonnet-5

# Optional: only needed if you use an ORG/ADMIN key instead of a workspace key.
# Find the workspace ID in the Anthropic Console under Settings > Workspaces.
# ANTHROPIC_WORKSPACE_ID=wrkspc_...

# ---------------------------------------------------------------------------
# GOOGLE SHEETS — escalation capture
# ---------------------------------------------------------------------------
# When the assistant declines a hostile/unanswerable message, it asks the
# visitor for their name and phone number. Those details are POSTed to a
# Google Apps Script Web App that appends a row to your Sheet.
#
# One-time setup:
#   1. Create a Google Sheet with columns: Timestamp | Name | Phone | Message | Source
#   2. In the Sheet: Extensions > Apps Script, and paste:
#
#        function doPost(e) {
#          var data = JSON.parse(e.postData.contents);
#          var sheet = SpreadsheetApp.getActiveSpreadsheet().getSheets()[0];
#          sheet.appendRow([data.timestamp, data.name, data.phone, data.message, data.source]);
#          return ContentService
#            .createTextOutput(JSON.stringify({ ok: true }))
#            .setMimeType(ContentService.MimeType.JSON);
#        }
#
#   3. Deploy > New deployment > type "Web app":
#        - Execute as: Me
#        - Who has access: Anyone
#      Copy the Web app URL (ends in /exec) and paste it below.
GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/XXXXXXXX/exec
