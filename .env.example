# Copy this file to .env.local and fill in your key.
# Get a key at https://console.anthropic.com/settings/keys
#
# IMPORTANT: Use a WORKSPACE-scoped key (created inside a Workspace), not an
# organization/admin key. Admin keys cannot call the Messages API directly.
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MAX_TOKENS=max-tokens

# Optional: override the Claude model (defaults to claude-sonnet-5)
# ANTHROPIC_MODEL=claude-sonnet-5

# Optional: only needed if you use an ORG/ADMIN key instead of a workspace key.
# Find the workspace ID in the Anthropic Console under Settings > Workspaces.
# ANTHROPIC_WORKSPACE_ID=wrkspc_...
